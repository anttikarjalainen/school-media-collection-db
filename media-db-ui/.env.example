# Copy to .env.local and replace the placeholder passwords.

# Superuser connection, used only by `npm run db:setup` to create the roles and databases.
ADMIN_DATABASE_URL=postgres://postgres:change-me@localhost:5432/postgres

# One owner role per database. db:setup creates these roles with the passwords given here.
BOOKS_DATABASE_URL=postgres://books_owner:change-me-books@localhost:5432/books_db
MOVIES_DATABASE_URL=postgres://movies_owner:change-me-movies@localhost:5432/movies_db
GAMES_DATABASE_URL=postgres://games_owner:change-me-games@localhost:5432/games_db
